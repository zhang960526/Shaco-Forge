{
  "name": "@shaco-forge/contracts",
  "version": "1.0.0-dev.1",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    "./compatibility": { "types": "./dist/compatibility.d.ts", "default": "./dist/compatibility.js" },
    "./p8-activation": { "types": "./dist/p8-activation.d.ts", "default": "./dist/p8-activation.js" },
    "./packaged-runtime": {
      "types": "./dist/packaged-runtime.d.ts",
      "default": "./dist/packaged-runtime.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
